#include <stdio.h>

int main(void)
{
    int n, i, j;
    char name[10][20];
    double score[10], point[10], sumPoint = 0.0, gpa;
    int credit[10], sumCredit = 0, failed = 0;
    char grade[10][3];
    int used[10] = {0};

    printf("=== GPA тооцоолуур ===\n");

    do {
        printf("Хичээлийн тоо (5-10): ");
        scanf("%d", &n);
        if (n < 5 || n > 10)
            printf("  Буруу! 5-аас 10 хооронд оруулна уу.\n");
    } while (n < 5 || n > 10);

    for (i = 0; i < n; i++) {
        printf("\n%d-р хичээлийн нэр (зайгүй): ", i + 1);
        scanf("%19s", name[i]);

 
        do {
            printf("  Оноо (0-100): ");
            scanf("%lf", &score[i]);
            if (score[i] < 0 || score[i] > 100)
                printf("  Буруу! 0-100 хооронд оруулна уу.\n");
        } while (score[i] < 0 || score[i] > 100);


        do {
            printf("  Кредит (1-6): ");
            scanf("%d", &credit[i]);
            if (credit[i] < 1 || credit[i] > 6)
                printf("  Буруу! 1-6 хооронд оруулна уу.\n");
        } while (credit[i] < 1 || credit[i] > 6);

        if (score[i] >= 90) {
            grade[i][0] = 'A'; grade[i][1] = '\0'; point[i] = 4.0;
        } else if (score[i] >= 85) {
            grade[i][0] = 'B'; grade[i][1] = '+'; grade[i][2] = '\0'; point[i] = 3.5;
        } else if (score[i] >= 80) {
            grade[i][0] = 'B'; grade[i][1] = '\0'; point[i] = 3.0;
        } else if (score[i] >= 75) {
            grade[i][0] = 'C'; grade[i][1] = '+'; grade[i][2] = '\0'; point[i] = 2.5;
        } else if (score[i] >= 70) {
            grade[i][0] = 'C'; grade[i][1] = '\0'; point[i] = 2.0;
        } else if (score[i] >= 60) {
            grade[i][0] = 'D'; grade[i][1] = '\0'; point[i] = 1.0;
        } else {
            grade[i][0] = 'F'; grade[i][1] = '\0'; point[i] = 0.0;
            failed++;
        }

        sumPoint += point[i] * credit[i];
        sumCredit += credit[i];
    }

    gpa = sumPoint / sumCredit;

    printf("\n================ ДҮНГИЙН ХУУДАС ================\n");
    printf("%-3s %-15s %7s %7s %6s %7s\n", "No", "Хичээл", "Оноо", "Кредит", "Үсэг", "Point");
    printf("------------------------------------------------\n");
    for (i = 0; i < n; i++) {
        printf("%-3d %-15s %7.2f %7d %6s %7.2f\n",
               i + 1, name[i], score[i], credit[i], grade[i], point[i]);
    }
    printf("------------------------------------------------\n");
    printf("Нийт кредит : %d\n", sumCredit);
    printf("Жинлэсэн GPA: %.2f\n", gpa);


    if (gpa >= 3.5 && failed == 0)
        printf("Үр дүн: Онц суралцагч\n");
    else if (gpa >= 2.0 && failed == 0)
        printf("Үр дүн: Хэвийн суралцагч\n");
    else if (gpa < 2.0 || failed > 0)
        printf("Үр дүн: Анхаарах шаардлагатай (унасан хичээл: %d)\n", failed);


    printf("\n--- Хамгийн өндөр 3 дүн ---\n");
    for (j = 1; j <= 3 && j <= n; j++) {
        int best = -1;
        for (i = 0; i < n; i++) {
            if (used[i] == 0 && (best == -1 || score[i] > score[best]))
                best = i;
        }
        used[best] = 1;
        printf("%d. %-15s %6.2f (%s)\n", j, name[best], score[best], grade[best]);
    }

    return 0;
}